# ============================================================
# amEmployer — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://amemployer:amemployer_secret@localhost:5432/amemployer_db"
POSTGRES_USER=amemployer
POSTGRES_PASSWORD=amemployer_secret
POSTGRES_DB=amemployer_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Backend Server ────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Celo Blockchain ───────────────────────────────────────
# Mainnet
CELO_RPC_URL="https://forno.celo.org"
CELO_MAINNET_RPC_URL="https://forno.celo.org"
CELO_CHAIN_ID=42220

# Alfajores testnet (comment out the mainnet lines above and use these for testing)
# CELO_RPC_URL="https://alfajores-forno.celo-testnet.org"
# CELO_CHAIN_ID=44787

# Deployer wallet — signs deployment and employer transactions.
# Use a dedicated hot wallet. Keep it funded with a small amount of CELO for gas.
DEPLOYER_PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY"
EMPLOYER_PRIVATE_KEY="0xYOUR_EMPLOYER_PRIVATE_KEY"

# AI Validator wallet (can be the same as employer for early deployment)
AI_VALIDATOR_PRIVATE_KEY="0xYOUR_VALIDATOR_PRIVATE_KEY"

# Deployed contract addresses — filled in automatically after running the deploy script
TASK_MANAGER_ADDRESS="0xA532809154b1f8A18c09aaf5E59B0e8de6049E0b"
WORKER_REGISTRY_ADDRESS="0x7b08eb88a15911BcF00b22011def1E02d7F7640b"

# cUSD token address — Celo Mainnet
CUSD_ADDRESS="0x765DE816845861e75A25fCA122bb6898B8B1282a"

# cUSD token address — Alfajores Testnet
# CUSD_ADDRESS="0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1"

# CeloScan API key — required for contract verification
# Get from https://celoscan.io/myapikey
CELOSCAN_API_KEY=""

# ── AI Providers ──────────────────────────────────────────
# Active provider: "claude" | "openai" | "mock"
AI_PROVIDER="claude"
AI_MODEL="claude-opus-4-5"

ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_KEY"
OPENAI_API_KEY="sk-YOUR_OPENAI_KEY"

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://your-backend-domain.com"
NEXT_PUBLIC_WS_URL="https://your-backend-domain.com"
NEXT_PUBLIC_CELO_RPC_URL="https://forno.celo.org"
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_CUSD_ADDRESS="0x765DE816845861e75A25fCA122bb6898B8B1282a"
NEXT_PUBLIC_TASK_MANAGER_ADDRESS="0xA532809154b1f8A18c09aaf5E59B0e8de6049E0b"

# ── Simulation ────────────────────────────────────────────
SIMULATION_WORKER_COUNT=100
SIMULATION_CONCURRENT_TASKS=20
SIMULATION_TASK_REWARD="0.1"
TASK_DELAY_MS=500

# ── Security ──────────────────────────────────────────────
# Must be at least 32 characters — used for AES-256 wallet key encryption
ENCRYPTION_KEY="replace-with-a-random-32-char-string!!"

JWT_SECRET="replace-with-a-long-random-jwt-secret"

# ============================================================
# amEmployer - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://amemployer:amemployer_secret@localhost:5432/amemployer_db"
POSTGRES_USER=amemployer
POSTGRES_PASSWORD=amemployer_secret
POSTGRES_DB=amemployer_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Backend Server ────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Celo Blockchain ───────────────────────────────────────
# Use Alfajores for testnet, mainnet for production
CELO_RPC_URL="https://alfajores-forno.celo-testnet.org"
CELO_CHAIN_ID=44787

# Employer AI agent private key (DO NOT commit real keys)
EMPLOYER_PRIVATE_KEY="0xYOUR_EMPLOYER_PRIVATE_KEY"

# AI Validator address (can be same as employer for demo)
AI_VALIDATOR_PRIVATE_KEY="0xYOUR_VALIDATOR_PRIVATE_KEY"

# Deployed contract addresses (filled after deployment)
TASK_MANAGER_ADDRESS=""
WORKER_REGISTRY_ADDRESS=""

# cUSD token address on Alfajores
CUSD_ADDRESS="0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1"

# ── AI Providers ──────────────────────────────────────────
# Primary: Claude (Anthropic)
ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_KEY"

# Fallback: OpenAI
OPENAI_API_KEY="sk-YOUR_OPENAI_KEY"

# Active AI provider: "claude" | "openai" | "mock"
AI_PROVIDER="claude"
AI_MODEL="claude-opus-4-5"

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
NEXT_PUBLIC_CELO_RPC_URL="https://alfajores-forno.celo-testnet.org"
NEXT_PUBLIC_CHAIN_ID=44787
NEXT_PUBLIC_CUSD_ADDRESS="0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1"
NEXT_PUBLIC_TASK_MANAGER_ADDRESS=""

# ── Simulation ────────────────────────────────────────────
SIMULATION_WORKER_COUNT=100
SIMULATION_FAUCET_PRIVATE_KEY="0xYOUR_FAUCET_KEY"
SIMULATION_CONCURRENT_TASKS=20
SIMULATION_TASK_REWARD="0.1" # in cUSD

# ── Security ──────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ENCRYPTION_KEY="your-32-char-encryption-key-here"
